config firewall policy
    edit 0
        set name "{{ policy.name }}"
        set srcintf "{{ lan.iface }}"
        set dstintf "{{ policy.dstintf }}"
        set action accept
        set srcaddr "all"
        set dstaddr "all"
        set schedule "always"
        set service "ALL"
        set nat enable
        set logtraffic all
    next
end
